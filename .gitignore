# Repo-root ignores for the frontend/ + backend/ split.
# The React app keeps its own rules in frontend/.gitignore.

# Python / Django
backend/venv/
backend/.venv/
__pycache__/
*.py[cod]
*.egg-info/
db.sqlite3
db.sqlite3-journal
/backend/media/
/backend/staticfiles/

# Secrets
.env
.env.*
!.env.example

# Tooling config, not project code (frontend/.gitignore does the same)

# Editors / OS
.DS_Store
Thumbs.db

# Scratch
.tmp/
.tmp-*
*.log

# Database dumps. A dumpdata export carries the admin account's password
# hash, so it must never be published - these are one-off migration
# artefacts, not part of the project.
backend/seed/*_dump.json
backend/seed/dump_err.txt
*.sql
*.dump

# collectstatic output, rebuilt on every deploy
backend/staticfiles/
